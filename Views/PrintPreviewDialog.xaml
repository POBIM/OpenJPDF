<Window x:Class="OpenJPDF.Views.PrintPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenJPDF - Print" 
        Height="700" Width="1000"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">
    
    <Window.Resources>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SettingComboBox" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style x:Key="SettingTextBox" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Settings Panel -->
        <Border Grid.Column="0" Background="#252526" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Printer Selection -->
                    <TextBlock Text="Printer" Style="{StaticResource SettingLabel}"/>
                    <ComboBox x:Name="PrinterComboBox" 
                              Style="{StaticResource SettingComboBox}"
                              SelectionChanged="PrinterComboBox_SelectionChanged"/>
                    
                    <!-- Paper Size -->
                    <TextBlock Text="Paper Size" Style="{StaticResource SettingLabel}"/>
                    <ComboBox x:Name="PaperSizeComboBox" 
                              Style="{StaticResource SettingComboBox}"
                              SelectionChanged="Settings_Changed">
                        <ComboBoxItem Content="A4 (210 × 297 mm)" Tag="A4"/>
                        <ComboBoxItem Content="Letter (8.5 × 11 in)" Tag="Letter"/>
                        <ComboBoxItem Content="Legal (8.5 × 14 in)" Tag="Legal"/>
                        <ComboBoxItem Content="A3 (297 × 420 mm)" Tag="A3"/>
                        <ComboBoxItem Content="A5 (148 × 210 mm)" Tag="A5"/>
                        <ComboBoxItem Content="B5 (176 × 250 mm)" Tag="B5"/>
                    </ComboBox>
                    
                    <!-- Orientation -->
                    <TextBlock Text="Orientation" Style="{StaticResource SettingLabel}"/>
                    <ComboBox x:Name="OrientationComboBox" 
                              Style="{StaticResource SettingComboBox}"
                              SelectionChanged="Settings_Changed">
                        <ComboBoxItem Content="Portrait" Tag="Portrait"/>
                        <ComboBoxItem Content="Landscape" Tag="Landscape"/>
                    </ComboBox>
                    
                    <!-- Page Range -->
                    <TextBlock Text="Pages" Style="{StaticResource SettingLabel}"/>
                    <StackPanel Margin="0,0,0,12">
                        <RadioButton x:Name="AllPagesRadio" Content="All Pages" 
                                     Foreground="#E0E0E0" IsChecked="True" GroupName="PageRange"
                                     Checked="PageRange_Changed" Margin="0,0,0,6"/>
                        <RadioButton x:Name="CurrentPageRadio" Foreground="#E0E0E0" GroupName="PageRange"
                                     Checked="PageRange_Changed" Margin="0,0,0,6">
                            <RadioButton.Content>
                                <TextBlock x:Name="CurrentPageLabel" Text="Current Page"/>
                            </RadioButton.Content>
                        </RadioButton>
                        <RadioButton x:Name="CustomRangeRadio" Foreground="#E0E0E0" GroupName="PageRange"
                                     Checked="PageRange_Changed" Margin="0,0,0,2">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Custom: " VerticalAlignment="Center"/>
                                    <TextBox x:Name="CustomRangeTextBox" Width="120" 
                                             Padding="4,2" VerticalAlignment="Center"
                                             GotFocus="CustomRangeTextBox_GotFocus"
                                             TextChanged="CustomRange_TextChanged"/>
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>
                        <TextBlock x:Name="PageRangeHint" 
                                   Foreground="#808080" FontSize="10" Margin="20,4,0,0"/>
                    </StackPanel>
                    
                    <!-- Copies -->
                    <TextBlock Text="Copies" Style="{StaticResource SettingLabel}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CopiesTextBox" Text="1" Padding="8,6"
                                 PreviewTextInput="CopiesTextBox_PreviewTextInput"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                            <Button Content="−" Width="28" Click="DecreaseCopies_Click"/>
                            <Button Content="+" Width="28" Click="IncreaseCopies_Click" Margin="2,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Scale -->
                    <TextBlock Text="Scale" Style="{StaticResource SettingLabel}"/>
                    <ComboBox x:Name="ScaleComboBox" 
                              Style="{StaticResource SettingComboBox}"
                              SelectionChanged="Settings_Changed">
                        <ComboBoxItem Content="Fit to Page" Tag="Fit" IsSelected="True"/>
                        <ComboBoxItem Content="Actual Size (100%)" Tag="100"/>
                        <ComboBoxItem Content="50%" Tag="50"/>
                        <ComboBoxItem Content="75%" Tag="75"/>
                        <ComboBoxItem Content="125%" Tag="125"/>
                        <ComboBoxItem Content="150%" Tag="150"/>
                        <ComboBoxItem Content="200%" Tag="200"/>
                    </ComboBox>
                    
                    <!-- Margins -->
                    <TextBlock Text="Margins" Style="{StaticResource SettingLabel}"/>
                    <ComboBox x:Name="MarginsComboBox" 
                              Style="{StaticResource SettingComboBox}"
                              SelectionChanged="Settings_Changed">
                        <ComboBoxItem Content="None" Tag="0"/>
                        <ComboBoxItem Content="Minimum" Tag="5"/>
                        <ComboBoxItem Content="Normal" Tag="15" IsSelected="True"/>
                        <ComboBoxItem Content="Wide" Tag="25"/>
                    </ComboBox>
                    
                    <!-- Color Mode -->
                    <TextBlock Text="Color" Style="{StaticResource SettingLabel}"/>
                    <ComboBox x:Name="ColorModeComboBox" 
                              Style="{StaticResource SettingComboBox}"
                              SelectionChanged="Settings_Changed">
                        <ComboBoxItem Content="Color" Tag="Color" IsSelected="True"/>
                        <ComboBoxItem Content="Grayscale" Tag="Grayscale"/>
                    </ComboBox>
                    
                    <!-- Print Options -->
                    <CheckBox x:Name="CollateCheckBox" Content="Collate" 
                              Foreground="#E0E0E0" Margin="0,0,0,8"/>
                    <CheckBox x:Name="DuplexCheckBox" Content="Double-sided (if supported)" 
                              Foreground="#E0E0E0" Margin="0,0,0,8"/>
                    
                </StackPanel>
            </ScrollViewer>
        </Border>
        
        <!-- Preview Panel -->
        <Grid Grid.Column="1" Background="#1E1E1E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Preview Toolbar -->
            <Border Grid.Row="0" Background="#333333" Padding="8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PrevPageButton" Content="◀" Width="32" 
                            Click="PrevPage_Click" Margin="0,0,8,0"/>
                    <TextBlock x:Name="PageIndicator" Text="Page 1 of 1" 
                               Foreground="#E0E0E0" VerticalAlignment="Center"
                               FontSize="14" Margin="0,0,8,0"/>
                    <Button x:Name="NextPageButton" Content="▶" Width="32" 
                            Click="NextPage_Click" Margin="0,0,16,0"/>
                    
                    <Button Content="−" Width="32" Click="ZoomOut_Click" Margin="0,0,4,0"/>
                    <TextBlock x:Name="ZoomIndicator" Text="100%" 
                               Foreground="#E0E0E0" VerticalAlignment="Center"
                               Width="50" TextAlignment="Center"/>
                    <Button Content="+" Width="32" Click="ZoomIn_Click"/>
                </StackPanel>
            </Border>
            
            <!-- Preview Area -->
            <ScrollViewer Grid.Row="1" x:Name="PreviewScrollViewer"
                          HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Auto"
                          Background="#404040">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                    <!-- Paper simulation -->
                    <Border x:Name="PaperBorder" Background="White" 
                            BorderBrush="#808080" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="5" 
                                              Opacity="0.4" Direction="315"/>
                        </Border.Effect>
                        <Grid x:Name="PaperGrid">
                            <!-- Margin indicators -->
                            <Rectangle x:Name="MarginBorder" Stroke="#E0E0E0" 
                                       StrokeThickness="1" StrokeDashArray="4,2"
                                       Margin="15" Fill="Transparent"/>
                            <!-- Page content -->
                            <Image x:Name="PreviewImage" Stretch="Uniform" 
                                   Margin="15" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
            
            <!-- Bottom Bar -->
            <Border Grid.Row="2" Background="#252526" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock x:Name="PrintSummary" Grid.Column="0"
                               Text="Ready to print" 
                               Foreground="#E0E0E0" VerticalAlignment="Center"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="PrintButton" Content="🖨️  Print" 
                                Width="100" Height="36" Margin="0,0,8,0"
                                Click="Print_Click"
                                Background="#0078D4" Foreground="White"
                                FontWeight="SemiBold"/>
                        <Button x:Name="CancelButton" Content="Cancel" 
                                Width="80" Height="36"
                                Click="Cancel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
